<section class="d-flex align-items-center bg-light" style="min-height: 100vh;">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-4">
          <div class="card-body p-4">

            <!-- Title -->
            <h3 class="mb-3 text-center text-primary fw-bold">
              Create Account
            </h3>
            <p class="text-center text-muted small mb-4">
              Join us and start shopping
            </p>

            <!-- Signup Form -->
            <form action="/signup" method="POST" novalidate id="userSignupForm">

              <div class="mb-3">
                <label class="form-label">Full Name</label>
                <input
                  type="text"
                  class="form-control"
                  name="Name"
                  placeholder="Enter your full name"
                  minlength="3"
                  required
                >
              </div>

              <div class="mb-3">
                <label class="form-label">Email address</label>
                <input
                  type="email"
                  class="form-control"
                  name="Email"
                  placeholder="Enter your email"
                  required
                >
              </div>

              <div class="mb-3">
                <label class="form-label">Mobile Number</label>
                <input
                  type="tel"
                  class="form-control"
                  name="Mobile"
                  pattern="\d{10}"
                  placeholder="10-digit number"
                  required
                >
              </div>

              <div class="mb-3">
                <label class="form-label">Password</label>
                <input
                  type="password"
                  class="form-control"
                  name="Password"
                  minlength="6"
                  placeholder="At least 6 characters"
                  required
                >
              </div>

              <p class="text-center text-danger small form-error"></p>

              <!-- Signup Button -->
              <div class="d-grid mt-4">
                <button type="submit" class="btn btn-success rounded-pill">
                  Sign Up
                </button>
              </div>

              <!-- Login redirect -->
              <div class="text-center mt-3">
                <a href="/login" class="text-decoration-none">
                  Already have an account? Login
                </a>
              </div>

              <!-- Divider -->
              <hr class="my-4">

              <!-- Admin Login Link -->
              <div class="text-center">
                <a href="/admin" class="text-decoration-none text-danger fw-semibold small">
                  🔐 Admin Login
                </a>
              </div>

            </form>

          </div>
        </div>
      </div>
    </div>
  </div>
</section>
