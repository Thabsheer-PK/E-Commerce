<section class="d-flex align-items-center bg-light" style="min-height: 100vh;">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-4">
          <div class="card-body p-4">

            <!-- Title -->
            <h3 class="mb-3 text-center text-danger fw-bold">
              🔐 Admin Login
            </h3>
            <p class="text-center text-muted small mb-4">
              Authorized access only
            </p>

            <!-- Login Form -->
            <form action="/admin/login" method="POST" novalidate>

              <!-- Username -->
              <div class="mb-3">
                <label class="form-label">Username</label>
                <input
                  type="text"
                  class="form-control"
                  name="username"
                  placeholder="Enter admin username"
                  required
                >
              </div>

              <!-- Password -->
              <div class="mb-3">
                <label class="form-label">Password</label>
                <input
                  type="password"
                  class="form-control"
                  name="password"
                  placeholder="Enter admin password"
                  required
                >
              </div>

              <!-- Error message -->
              <p class="text-danger text-center small form-error"></p>

              <!-- Login Button -->
              <div class="d-grid mt-4">
                <button type="submit" class="btn btn-danger rounded-pill">
                  Login
                </button>
              </div>

              <!-- User Login Link -->
              <div class="text-center mt-3">
                <a href="/login" class="text-decoration-none small text-muted">
                  Login as User
                </a>
              </div>

            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
